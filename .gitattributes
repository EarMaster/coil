# The wrapper script must stay LF whatever a contributor's core.autocrlf is set to: CRLF
# line endings make it unrunnable on the Linux CI runner.
gradlew text eol=lf
*.bat text eol=crlf
*.jar binary
# Golden screenshots. Marking them binary keeps Git from trying to diff or convert them, and
# keeps a merge conflict in one from producing an unopenable file.
*.png binary
