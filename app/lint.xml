<?xml version="1.0" encoding="utf-8"?>
<lint>

    <!--
      Lint suggests merging mipmap-anydpi-v26 into mipmap-anydpi because minSdk is already
      26. Following that advice breaks the build: AAPT2 does not resolve the adaptive icon
      from an unversioned anydpi folder, and the manifest's @mipmap/ic_launcher stops
      resolving altogether. The versioned folder stays.
    -->
    <issue id="ObsoleteSdkInt">
        <ignore path="src/main/res/mipmap-anydpi-v26" />
    </issue>

    <!--
      Permitting cleartext is the whole point of that file, so lint's warning is correct and
      the answer to it is still "yes". A Phoniebox serves its cover art over plain HTTP from
      the LAN and offers no HTTPS at all; the alternative to this setting is not a more
      secure cover, it is no cover. The reasoning, and why it cannot be narrowed to a
      domain-config, is in the file itself. Scoped to that one path so a stray cleartext
      permission anywhere else still gets reported.
    -->
    <issue id="InsecureBaseConfiguration">
        <ignore path="src/main/res/xml/network_security_config.xml" />
    </issue>

</lint>
