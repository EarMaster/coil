<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      The Compose theme in ui/theme/Theme.kt owns all colour. This XML theme only
      has to hand the window over without a flash of the wrong background, so it
      stays deliberately thin.
    -->
    <style name="Theme.Coil" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Transparent shell for PlayShortcutActivity: it fires an RPC and finishes. -->
    <style name="Theme.Coil.Transparent" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

</resources>
